# ---------------------------------------------------------------
# Berger — variables d'environnement (copier en .env.local)
# ---------------------------------------------------------------
# Sans ces variables, l'application fonctionne en MODE LOCAL :
# comptes et dossiers sur l'appareil uniquement, chiffrés, sans serveur.

# --- Application web (préfixe VITE_ : visibles dans le navigateur, uniquement des valeurs publiques) ---
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=cle-publique-anon

# --- Fonctions serveur Supabase (à définir avec `supabase secrets set`, JAMAIS dans le navigateur) ---
# IA (fonction "ai")
AI_PROVIDER=anthropic            # anthropic | openai
AI_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_BASE_URL=                     # pour un fournisseur compatible OpenAI
# Transcription (fonction "transcribe")
STT_API_KEY=
STT_BASE_URL=https://api.openai.com/v1
STT_MODEL=whisper-1
# WhatsApp Business Platform (fonctions "whatsapp-send" et "whatsapp-webhook")
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_DEFAULT_COUNTRY=228
WA_TEMPLATE_NAME=                # modèle approuvé par Meta (messages hors fenêtre de 24 h)
WA_TEMPLATE_LANG=fr
WA_VERIFY_TOKEN=
WA_APP_SECRET=
CRON_SECRET=                     # secret partagé avec le planificateur qui appelle whatsapp-send
ALLOWED_ORIGIN=https://berger.votre-domaine.tg
